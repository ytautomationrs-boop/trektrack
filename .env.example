# Required in Hostinger
DATABASE_URL=
JWT_SECRET=
NODE_ENV=production

# Required only if deposits or automated provider payouts are enabled.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

# Hostinger supplies PORT at runtime. Leave unset unless your host asks for it.
PORT=

# Set true only when migrations are applied separately, such as when using a
# transaction-pooler DATABASE_URL that is suitable for runtime queries but not
# Prisma migrate.
SKIP_PRISMA_MIGRATE=false

# Keep false on Hostinger web processes. Set true only for a controlled one-off
# redeploy when you specifically want startup to run Prisma migrate + repair.
RUN_STARTUP_DATABASE_MAINTENANCE=false

# Keep false on Hostinger. Run seed as a one-off database/admin task, not on
# every web process boot.
RUN_PRISMA_SEED_ON_START=false

# Public production origin, for web payment/OAuth callback redirects.
WEB_APP_URL=https://lightsteelblue-giraffe-860469.hostingersite.com

# Optional comma-separated bootstrap admin emails for the admin console.
ADMIN_EMAILS=

# Optional Strava integration. Leave blank to disable Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEB_REDIRECT_URI=https://your-domain.example/integrations/strava/web-callback
STRAVA_REDIRECT_URI=https://your-domain.example/integrations/strava/mobile-callback

# Optional Expo push token, only needed if Expo push enhanced security is enabled.
EXPO_ACCESS_TOKEN=

# Runtime client-facing support/legal links.
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=

# Pilot money model flags. Defaults are false when unset.
DEPOSITS_ENABLED=false
AUTOMATED_PAYOUTS_ENABLED=false

# Keep false on Hostinger until the web app is stable. Background jobs can be
# moved to a worker/cron later instead of running inside the web process.
RUN_BACKGROUND_JOBS=false
