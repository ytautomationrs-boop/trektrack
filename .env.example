# Required in Hostinger
DATABASE_URL=
JWT_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
NODE_ENV=production

# Hostinger supplies PORT at runtime. Leave unset unless your host asks for it.
PORT=

# Public production origin, for web payment/OAuth callback redirects.
WEB_APP_URL=https://your-domain.example

# Optional Strava integration. Leave blank to disable Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEB_REDIRECT_URI=https://your-domain.example/integrations/strava/web-callback
STRAVA_REDIRECT_URI=https://your-domain.example/integrations/strava/mobile-callback

# Optional Expo push token, only needed if Expo push enhanced security is enabled.
EXPO_ACCESS_TOKEN=

# Runtime client-facing support/legal links.
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=

# Pilot money model flags. Defaults are false when unset.
DEPOSITS_ENABLED=false
AUTOMATED_PAYOUTS_ENABLED=false
