# Backend URL as seen from the device/emulator/browser, not from this machine.
# This is inlined at BUNDLE TIME (EXPO_PUBLIC_* vars aren't read at runtime),
# so switching platforms means changing this and restarting the bundler —
# there is no single value that works for every target at once.
# - Web (`expo start --web`): localhost works directly, same as this machine.
# - iOS Simulator: localhost also works directly (shares the Mac's network namespace).
# - Android emulator: the host's localhost is reachable at 10.0.2.2, not localhost.
# - Physical device: use your machine's LAN IP (e.g. http://192.168.1.23:4000).
EXPO_PUBLIC_API_URL=http://localhost:4000
