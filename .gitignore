# Secrets — never commit real credentials (Paystack, PayPal, Strava, JWT, DB URLs).
# .env.example files are safe templates and are NOT excluded by this rule.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build / cache output
dist/
build/
.expo/
.gradle/
*.log

# The exported web bundle, staged here by scripts/build-web.sh at deploy
# time. Generated from mobile/ — never edit or commit it.
backend/public/

# Native project output generated by `expo prebuild` — regenerate, don't commit.
mobile/android/
mobile/ios/

# Database dumps / local data — these contain real user data, never commit.
backups/
*.sqlite
*.sqlite3
*.db
pgdata/

# OS / editor cruft
.DS_Store
Thumbs.db

# Local tool state
.claude/
