# Postgres. For Hostinger production, use an externally reachable PostgreSQL
# connection string, not localhost.
DATABASE_URL=

# Auth
JWT_SECRET=

# Paystack TEST MODE keys only — never put live (sk_live_/pk_live_) keys here.
# Get test keys from https://dashboard.paystack.com/#/settings/developer
# Used for both deposits (Transactions API) and withdrawals (Transfers API).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# PayPal sandbox — Payouts API, the other withdrawal method alongside
# Paystack Transfers. Get sandbox "Default Application" credentials from
# https://developer.paypal.com/dashboard/applications/sandbox — never
# live/production credentials here.
PAYPAL_SANDBOX_CLIENT_ID=""
PAYPAL_SANDBOX_SECRET=""

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=""

# Optional — cycling/running races/challenges work fully on HealthKit/Health
# Connect alone without these; on the WEB pilot (no HealthKit/Health Connect
# in a browser) Strava is the PRIMARY verification method instead. Register
# a free app at https://developers.strava.com to enable it. Set Authorization
# Callback Domain to match the host in the two redirect URIs below
# ("localhost" for dev, your HTTPS domain for Hostinger) — Strava rejects a
# bare custom app scheme, so both must be real http(s) URLs; see
# modules/integrations/strava/routes.ts
# mobile-callback / web-callback for how each bridges to its app.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Native apps: bridges to the streak:// custom scheme (expo-web-browser
# intercepts it on-device). Leave unset if you have no native build yet.
STRAVA_REDIRECT_URI="http://localhost:4000/integrations/strava/mobile-callback"
# Web pilot: bridges to a real page on WEB_APP_URL instead — a browser tab
# can't intercept a custom scheme the way expo-web-browser does natively.
STRAVA_WEB_REDIRECT_URI="http://localhost:4000/integrations/strava/web-callback"
# Where the web pilot itself is served from — `expo start --web`'s default
# port in dev; the deployed Hostinger HTTPS origin in production.
WEB_APP_URL="https://lightsteelblue-giraffe-860469.hostingersite.com"

PORT=4000
NODE_ENV="development"

# Production runs startup database maintenance by default. Do not set this to
# false on Hostinger; use DISABLE_STARTUP_DATABASE_MAINTENANCE=true only if
# migrations are handled by a separate job.
RUN_STARTUP_DATABASE_MAINTENANCE=true
DISABLE_STARTUP_DATABASE_MAINTENANCE=false
FORCE_DATABASE_RUNTIME_REPAIR=false

# Surfaced to the client at runtime via GET /config (not baked into the web
# bundle, so these can change without a rebuild). The Profile screen hides
# any row that isn't set — a dead Terms link is worse than no link.
# All three should be set before a real-money pilot.
SUPPORT_EMAIL=""
TERMS_URL=""
PRIVACY_URL=""
